{
  "compilerOptions": {
    "strict": true,
    "noImplicitAny": true,
    "noUncheckedIndexedAccess": true,
    "exactOptionalPropertyTypes": true,
    "skipLibCheck": true,
    "module": "esnext",
    "moduleResolution": "bundler",
    "target": "es2022",
    "lib": [
      "es2022",
      "es2023"
    ],
    "jsx": "react-jsx",
    "allowImportingTsExtensions": true,
    "esModuleInterop": true,
    "noEmit": true,
    "paths": {
      "@deepseek-ai/dsh-client-ui-slots": [
        "../dsh2026/deepseek-harness/packages/client/ui-slots/src/index.ts"
      ],
      "@deepseek-ai/dsh-client-ui-renderer/client": [
        "../dsh2026/deepseek-harness/packages/client/ui-renderer/src/client/index.ts"
      ],
      "@deepseek-ai/dsh-client-store": [
        "../dsh2026/deepseek-harness/packages/client/store/src/index.ts"
      ],
      "@deepseek-ai/dsh-client-ui-primitives": [
        "../dsh2026/deepseek-harness/packages/client/ui-primitives/src/index.ts"
      ]
    }
  },
  "include": [
    "src"
  ],
  "exclude": [
    "src/client"
  ]
}
